	$(MAKE) $(MAKESILENT) -f CMakeFiles/avalia_console.dir/build.make CMakeFiles/avalia_console.dir/main_console.cpp.i
.PHONY : main_console.cpp.i

main_console.s: main_console.cpp.s
.PHONY : main_console.s

# target to generate assembly for a file
main_console.cpp.s:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/avalia_console.dir/build.make CMakeFiles/avalia_console.dir/main_console.cpp.s
.PHONY : main_console.cpp.s

